# Copy to .env.local and fill in. Never commit .env.local.

# ── Admin dashboard ──────────────────────────────────────────────────────
# First-run password for /admin. Change it from inside the dashboard after
# the first sign-in; the stored hash then takes over from this value.
ADMIN_PASSWORD=

# ── Email (Resend) ───────────────────────────────────────────────────────
# Serverless hosts block outbound SMTP, so production needs the HTTP API.
# resend.com → API Keys. Free tier: 3,000 emails/month.
# The sending domain (gauldentrap.com) must be verified in Resend first —
# add the DKIM/SPF records it gives you. This is send-only and does NOT
# touch the MX records, so Spacemail keeps handling inbound mail.
RESEND_API_KEY=
MAIL_FROM=Gauldentrap <noreply@gauldentrap.com>
# Fallbacks only — /admin/settings overrides both at runtime, so a dead
# mailbox can be routed around without a redeploy.
MAIL_REPLY_TO=support@gauldentrap.com
MAIL_OWNER=support@gauldentrap.com

# ── Optional SMTP fallback ───────────────────────────────────────────────
# Only used if RESEND_API_KEY is unset. Most serverless hosts block this.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=

# ── Supabase (production storage: orders, subscribers, settings, auth) ───
# Server-only secrets. Run supabase/schema.sql once before the first deploy.
SUPABASE_URL=https://vkbhgbhjkaidgujlkhog.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# ── Images ───────────────────────────────────────────────────────────────
# Optional jsDelivr mirror of the public repo, to keep ~15MB of product
# imagery off Netlify's bandwidth. Leave empty to serve from the site.
NEXT_PUBLIC_IMAGE_CDN=
